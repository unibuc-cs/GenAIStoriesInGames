# Normalize line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Windows-only files keep CRLF in the working copy.
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf
*.sln        text eol=crlf
*.slnx       text eol=crlf
*.vcxproj    text eol=crlf

# Source and config are text.
*.h          text
*.cpp        text
*.cs         text
*.ini        text
*.json       text
*.md         text
*.uproject   text

# Unreal binary assets - never diff or line-ending-convert these.
*.uasset     binary
*.umap       binary
*.upk        binary
*.udk        binary
*.pdb        binary
*.dll        binary
*.exe        binary
*.lib        binary
*.png        binary
*.jpg        binary
*.wav        binary
*.fbx        binary
